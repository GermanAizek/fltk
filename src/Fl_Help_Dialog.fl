  Function {textsize(Fl_Fontsize s)} {return_type void
  } {
    code {view_->textsize(s);

if (s <= 8)
  smaller_->deactivate();
else
  smaller_->activate();

if (s >= 18)
  larger_->deactivate();
else
  larger_->activate();} {}
  }
  Function {textsize()} {return_type Fl_Fontsize
  } {
    code {return (view_->textsize());} {}
